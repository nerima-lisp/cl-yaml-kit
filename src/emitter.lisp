;;;; src/emitter.lisp
(in-package #:yaml-kit)

(defun %emit-prefix (event context)
  (when (typep event 'scalar-event)
    (when (scalar-event-anchor event)
      (%emit-text context "&")
      (%emit-text context (scalar-event-anchor event))
      (%emit-text context " "))
    (when (scalar-event-tag event)
      (%emit-text context (scalar-event-tag event))
      (%emit-text context " "))))

(defun emit-event-stream (events stream &key (indent 2) (width 80)
                                      (explicit-document-start nil))
  (let ((context (make-emitter-context stream indent width))
        (stack nil)
        (first-document t))
    (labels ((flow-p () (and stack (member (caar stack) '(:flow :flow-map))))
             (map-p () (and stack (member (caar stack) '(:map :flow-map))))
             (separator ()
               (when (and stack (flow-p) (plusp (cdar stack)))
                 (%emit-text context ", ")))
             (start-value ()
               (when stack
                 (let ((frame (car stack)))
                   (cond
                     ((map-p)
                      (if (oddp (cdr frame))
                          (%emit-text context ": ")
                          (if (flow-p)
                              (separator)
                              (progn
                                (unless (emitter-context-line-start context)
                                  (%emit-newline context))
                                (%emit-text context
                                            (make-string (* (1- (length stack)) indent)
                                                         :initial-element #\Space))))))
                     ((emitter-context-line-start context)
                      (%emit-text context
                                  (make-string (* (1- (length stack)) indent)
                                               :initial-element #\Space))
                      (%emit-text context "- "))
                     ((flow-p)
                      (separator))
                     (t
                      (%emit-newline context)
                      (%emit-text context
                                  (make-string (* (1- (length stack)) indent)
                                               :initial-element #\Space))
                      (%emit-text context "- ")))))))
      (dolist (event events)
        (cond
          ((stream-start-event-p event))
          ((stream-end-event-p event)
           (unless (emitter-context-line-start context) (%emit-newline context)))
          ((document-start-event-p event)
           (when (or explicit-document-start (document-start-event-explicit-p event))
             (when (not first-document) (%emit-newline context))
             (%emit-text context "---") (%emit-newline context))
           (setf first-document nil))
          ((document-end-event-p event)
           (unless (emitter-context-line-start context) (%emit-newline context)))
          ((scalar-event-p event)
           (start-value)
           (%emit-prefix event context)
           (%write-scalar (scalar-event-value event)
                          (%scalar-style (scalar-event-value event)
                                         (scalar-event-style event)
                                         (flow-p) width)
                          (emitter-context-stream context))
           (setf (emitter-context-line-start context) nil)
           (when stack (incf (cdr (car stack)))))
          ((alias-event-p event)
           (start-value)
           (%emit-text context "*")
           (%emit-text context (alias-event-anchor event))
           (when stack (incf (cdr (car stack)))))
          ((sequence-start-event-p event)
           (start-value)
           (push (cons (if (eq (sequence-start-event-style event) :flow) :flow :seq) 0)
                 stack)
           (when (flow-p) (%emit-text context "[")))
          ((mapping-start-event-p event)
           (start-value)
           (push (cons (if (eq (mapping-start-event-style event) :flow) :flow-map :map) 0)
                 stack)
           (when (flow-p) (%emit-text context "{")))
          ((sequence-end-event-p event)
           (let ((frame (pop stack)))
             (when (eq (car frame) :flow) (%emit-text context "]"))
             (when stack (incf (cdr (car stack))))))
          ((mapping-end-event-p event)
           (let ((frame (pop stack)))
             (when (eq (car frame) :flow-map) (%emit-text context "}"))
             (when stack (incf (cdr (car stack))))))))
    stream)))
