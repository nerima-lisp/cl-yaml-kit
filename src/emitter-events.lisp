(in-package #:yaml-kit)

(defun %emit-stream-start-event (event state lookahead) (declare (ignore event state lookahead)))
(defun %emit-stream-end-event (event state lookahead)
  (declare (ignore event lookahead))
  (let ((context (emitter-frame-state-context state)))
    (unless (emitter-context-line-start context) (%emit-newline context))))
(progn
  (defun %document-start-lookahead-empty-collection-p (lookahead)
    (or (and (sequence-start-event-p (car lookahead))
             (sequence-end-event-p (cadr lookahead)))
        (and (mapping-start-event-p (car lookahead))
             (mapping-end-event-p (cadr lookahead)))))

  (defun %document-start-marker-needed-p (event state lookahead)
    (or (emitter-frame-state-explicit state)
        (document-start-event-explicit-p event)
        (document-start-event-version event)
        (document-start-event-tag-directives event)
        (and (not (emitter-frame-state-suppress state))
             (document-end-event-p (car lookahead)))
        (and (not (emitter-frame-state-suppress state))
             (%document-start-lookahead-empty-collection-p lookahead))))

  (defun %emit-document-start-compatibility-version
      (event state lookahead context)
    (when (and (not (emitter-frame-state-first-document state))
               (emitter-frame-state-previous-document-explicit-end state)
               (document-start-event-explicit-p event)
               (mapping-start-event-p (car lookahead))
               (null (document-start-event-version event)))
      (%emit-text context "%YAML 1.2")
      (%emit-newline context)))

  (defun %document-start-value-follows-marker-p (lookahead)
    (or (and (scalar-event-p (car lookahead))
             (plusp (length (scalar-event-value (car lookahead)))))
        (alias-event-p (car lookahead))
        (and (sequence-start-event-p (car lookahead))
             (eq (sequence-start-event-style (car lookahead)) :flow))))

  (defun %emit-document-start-marker (lookahead context)
    (%emit-text context "---")
    (if (%document-start-value-follows-marker-p lookahead)
        (%emit-text context " ")
        (%emit-newline context)))

  (defun %emit-document-start-event (event state lookahead)
    (%emit-document-directives event (emitter-frame-state-context state))
    (let ((context (emitter-frame-state-context state)))
      (when (%document-start-marker-needed-p event state lookahead)
        (when (and (not (emitter-frame-state-first-document state))
                   (not (emitter-context-line-start context)))
          (%emit-newline context))
        (%emit-document-start-compatibility-version event state lookahead context)
        (%emit-document-start-marker lookahead context)))
    (setf (emitter-frame-state-first-document state) nil))

  (defun %scalar-event-key-p (state)
    (and (emitter-frame-state-stack state)
         (%frame-map-p state)
         (evenp (cdar (emitter-frame-state-stack state)))))

  (defun %scalar-event-map-value-p (state)
    (and (emitter-frame-state-stack state)
         (%frame-map-p state)
         (oddp (cdar (emitter-frame-state-stack state)))))

  (defun %scalar-event-leading-indicator-p (event key-p map-value-p)
    (let ((value (scalar-event-value event)))
      (and (or key-p map-value-p)
           (eq (scalar-event-style event) :plain)
           (plusp (length value))
           (or (char= (char value 0) #\?)
               (and (char= (char value 0) #\:)
                    (> (length value) 1)
                    (not (yaml-whitespace-p (char value 1))))))))

  (defun %scalar-event-style (event state key-p map-value-p)
    (let ((value (scalar-event-value event)))
      (if (%scalar-event-leading-indicator-p event key-p map-value-p)
          :plain
          (%scalar-style value (scalar-event-style event) (%frame-flow-p state)
                         (scalar-event-tag event)))))

  (defun %scalar-event-protected-value-p (event value)
    (and (%yaml-tag-suffix-p (scalar-event-tag event) "str")
         (member value *protected-scalar-values* :test #'string=)))

  (defun %scalar-event-preserve-indent-p (lookahead)
    (not (some (lambda (candidate)
                 (and (document-end-event-p candidate)
                      (document-end-event-explicit-p candidate)))
               lookahead)))

  (defun %emit-scalar-event (event state lookahead)
    (let* ((context (emitter-frame-state-context state))
           (value (scalar-event-value event))
           (empty (zerop (length value)))
           (key-p (%scalar-event-key-p state))
           (map-value-p (%scalar-event-map-value-p state))
           (style (%scalar-event-style event state key-p map-value-p)))
      (when (%scalar-event-protected-value-p event value)
        (setf style :single-quoted))
      (%frame-start-value state event)
      (%emit-prefix event context)
      (unless (and empty (eq (scalar-event-style event) :plain)
                   (null (scalar-event-tag event)))
        (%write-scalar value style context
                       (* (max 1 (length (emitter-frame-state-stack state)))
                          (emitter-frame-state-indent state))
                       (%scalar-event-preserve-indent-p lookahead)))
      (when (emitter-frame-state-stack state)
        (incf (cdar (emitter-frame-state-stack state))))
      (when key-p
        (setf (emitter-frame-state-last-key-style state) style)))))
(defun %emit-document-end-event (event state lookahead)
  (declare (ignore lookahead))
  (let ((context (emitter-frame-state-context state)))
    (setf (emitter-frame-state-previous-document-explicit-end state)
          (document-end-event-explicit-p event))
    (when (document-end-event-explicit-p event)
      (unless (emitter-context-line-start context) (%emit-newline context))
      (%emit-text context "...") (%emit-newline context))
    (unless (emitter-context-line-start context) (%emit-newline context))))

(defun %emit-alias-event (event state lookahead)
  (declare (ignore lookahead))
  (%frame-start-value state) (%emit-text (emitter-frame-state-context state) "*")
  (%emit-text (emitter-frame-state-context state) (alias-event-anchor event))
  (when (emitter-frame-state-stack state) (incf (cdar (emitter-frame-state-stack state)))))
